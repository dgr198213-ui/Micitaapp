# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. NEVER prefix with NEXT_PUBLIC_, never ship to the client bundle (§8.3).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public site URL, used to build magic-link / manage-appointment URLs in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email notifications). Without this, notification_jobs are claimed and logged
# but no email is actually sent — fine for local development, required in production.
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFICATIONS_FROM_EMAIL=reservas@tudominio.com

# Upstash Redis (rate limiting, §8.4). Without these, rate limiting fails open (never
# blocks) — fine for local development, required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` (see vercel.json).
# Required in production; the /api/cron/* routes refuse unauthenticated requests once
# NODE_ENV=production.
CRON_SECRET=
